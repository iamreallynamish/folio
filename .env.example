# Copy to .env.local for local runs against Supabase, or set these in Vercel → Project → Settings → Environment Variables.

# Supabase → Project → Connect → "Transaction pooler" connection string (port 6543), with your database password filled in.
# Leave unset locally to use the embedded database in data/pglite.
DATABASE_URL=

# Optional: Supabase → Project Settings → Database → SSL Configuration → download certificate, paste its contents
# (newlines may be written as \n). With it set, the database server's certificate is verified.
DATABASE_CA=

# Required in production: a long random string used to encrypt stored API keys. Generate with:  openssl rand -hex 32
# Keep it stable — changing it makes saved Alpha Vantage / Anthropic keys unreadable (users would re-enter them).
FOLIO_SECRET=
